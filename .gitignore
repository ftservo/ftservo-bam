# ---- Python 缓存 / 编译产物 ----
**/__pycache__
**.pyc
**.pyo

# ---- 编辑器临时文件 ----
**.swp
*~

# ---- 虚拟环境 / 构建产物 ----
.venv/
build/
dist/
bam.egg-info/
better_actuator_models.egg-info/
docs/_build/
docs/autoapi/
uv.lock

# ---- 本地草稿 / 运行痕迹 ----
trash/
data/
bak_*/
notes.md
params.json

# ---- 数据采集 / 参数辨识工作区（脚本运行时生成，不入库）----
data_raw/
data_processed/
data_raw_*/
data_processed_*/
